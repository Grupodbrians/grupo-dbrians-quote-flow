# Copia este archivo como .env.local para desarrollo local (NUNCA lo subas a GitHub).
# En producción, estas mismas variables se configuran en Vercel → Settings → Environment Variables.

# --- Supabase (login, historial compartido, usuarios, auditoría) ---
# Se obtienen en Supabase → tu proyecto → Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
# Las mismas dos de arriba, sin el prefijo VITE_ (las usan las funciones del servidor):
SUPABASE_URL=https://tu-proyecto.supabase.co
# La "service role key" — NUNCA la publiques, solo va en el servidor (Vercel):
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Anthropic (extracción de datos del PDF del proveedor) ---
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
